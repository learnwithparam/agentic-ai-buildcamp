# Models go through OpenRouter. The OpenAI SDK reads OPENAI_BASE_URL by itself.
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-6-luna

# Local Langfuse (see docs/learner/00-setup.md).
LANGFUSE_PUBLIC_KEY=pk-lf-workshop
LANGFUSE_SECRET_KEY=sk-lf-workshop
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PROMPT_NAME=hcp-medinfo-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=hcp-medinfo-workshop
