# Copy to .env (git-ignored) and fill in the key. Never commit .env.
# replay (the default) needs no key. gateway sends calls to LiteLLM: bun run up --gateway
# The gateway calls the models on OpenRouter, so it needs OPENROUTER_API_KEY.
LLM_PROVIDER=replay
OPENROUTER_API_KEY=
# Optional: force one role to one model, for example MODEL_SMART=openai/gpt-6-luna
