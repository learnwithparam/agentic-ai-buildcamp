# Models go through OpenRouter. The OpenAI SDK reads OPENAI_BASE_URL by itself.
# From lesson 10, the OpenRouter key is used only by the behavior decision below; every other
# model call goes through the Langfuse AI gateway with the two GATEWAY_KEY_ values.
OPENAI_API_KEY=sk-or-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-6-luna
# The behavior judge in dataset:run uses the Decisions API. It returns one typed choice, never text.
DECISION_MODEL=openai/gpt-6-luna-decisions
DECISIONS_URL=https://openrouter.ai/api/alpha/decisions

# The Langfuse AI gateway (lesson 10). One key per service, made under AI Gateway in Langfuse.
LANGFUSE_GATEWAY_URL=http://localhost:3031
GATEWAY_KEY_MEDINFO_APP=
GATEWAY_KEY_EVAL_RUNNER=

# Sign-in and permissions (lesson 11). npm run identity:setup generates every secret here,
# starts infra/docker-compose.yml (Postgres, Keycloak, OpenFGA) and seeds the doctors.
# Leave the empty ones empty: the script fills them and never prints them.
APP_URL=http://127.0.0.1:3333
OIDC_ISSUER=http://localhost:8180/realms/medinfo
OIDC_CLIENT_ID=medinfo-chat
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=medinfo-api
FGA_API_URL=http://localhost:8280
FGA_API_TOKEN=
FGA_STORE_ID=
FGA_MODEL_ID=
DATABASE_URL=
TEST_DATABASE_URL=
# Lesson 16: each company's event signing secret (npm run identity:setup writes them).
EVENT_SECRET_PHARMA_A=
EVENT_SECRET_PHARMA_B=
# Read by infra/docker-compose.yml.
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
OPENFGA_DB_PASSWORD=
MEDINFO_DB_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# The four seeded doctors share this password. Read it from your own .env to sign in.
SEED_USER_PASSWORD=

# Local Langfuse (see docs/learner/00-setup.md).
LANGFUSE_PUBLIC_KEY=pk-lf-workshop
LANGFUSE_SECRET_KEY=sk-lf-workshop
LANGFUSE_BASE_URL=http://localhost:5174
LANGFUSE_PROMPT_NAME=hcp-medinfo-agent
LANGFUSE_PROMPT_LABEL=production

DATASET_NAME=hcp-medinfo-workshop
