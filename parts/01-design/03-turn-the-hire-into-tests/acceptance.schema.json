{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "acceptance.yaml",
  "description": "Acceptance cases for one AI employee. Each case expects rows in the system of record, never a reply.",
  "type": "object",
  "required": ["employee", "cases"],
  "additionalProperties": false,
  "properties": {
    "employee": { "type": "string", "minLength": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "kind", "given", "job", "expect"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "kind": { "enum": ["outcome", "must-never", "approval", "edge"] },
          "given": { "type": "string", "minLength": 10 },
          "job": { "type": "object" },
          "forbids": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)+$" },
          "approver": { "type": "string", "minLength": 1 },
          "expect": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["table", "where", "rows"],
              "additionalProperties": false,
              "properties": {
                "table": { "type": "string", "pattern": "^[a-z_]+$" },
                "where": { "type": "object" },
                "rows": { "type": "integer", "minimum": 0 },
                "values": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
