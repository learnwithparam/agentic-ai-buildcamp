{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tools.yaml",
  "description": "Every tool one AI employee may call, what it can change, and who must say yes.",
  "type": "object",
  "required": ["employee", "tenant", "tools"],
  "additionalProperties": false,
  "properties": {
    "employee": { "type": "string", "minLength": 1 },
    "tenant": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "does", "risk", "tenant", "approval"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z]+(_[a-z]+)+$" },
          "does": { "enum": ["reads", "writes"] },
          "risk": { "enum": ["read", "undoable write", "final write"] },
          "tenant": { "enum": ["own", "any"] },
          "approval": { "type": "string", "minLength": 1 },
          "must_never": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    }
  }
}
