model
  schema 1.1

# Lesson 11. Who may read which label text.
# Facts about a doctor (their company, their country) come from the signed Keycloak token and are
# sent with each question as contextual tuples, so Keycloak stays the one place they are kept.
# Facts about a document (whose it is, where it is approved) are stored here by npm run identity:setup.

type user

type company
  relations
    define member: [user]
    define medical_reviewer: [user]
    define safety_reviewer: [user]
    # Lesson 14: a sales rep approves each outreach step before it reaches a doctor.
    define sales_rep: [user]
    # Lesson 17: the nightly sweep. It views doctors and plans steps like a rep, and decides nothing:
    # no can_decide below names it, so every step it plans waits for a person.
    define sweep_agent: [user]
    # Lesson 22: asks the insights agent about the company's sales.
    define analyst: [user]

type country
  relations
    define doctor: [user]

type document
  relations
    define owner: [company]
    define approved_in: [country]
    # Both must hold: your company owns it, and it is approved where you practise.
    define can_read: member from owner and doctor from approved_in
    # The desk's lookup tools (label_versions, approval_status, read_section and the others in
    # src/server/tools.ts) answer about the company's label in another country too, and mark it
    # as that country's. Search stays on can_read; another company's labels stay out of both.
    define can_read_abroad: member from owner
    # Lesson 14. The fact-checker reads every country's claims of its own company, so it can say
    # "approved in the US, not in Germany". Only the staff who send and approve emails use it;
    # a doctor does not, and another company's claims stay out.
    define can_check_against: sales_rep from owner or medical_reviewer from owner or sweep_agent from owner

# Lesson 14. A doctor's profile in the CRM belongs to the company whose reps call on them.
type hcp
  relations
    define owner: [company]
    # Only the company's sales reps: a doctor signed in to the desk never sees another doctor's record.
    define can_view: sales_rep from owner or sweep_agent from owner

# Lesson 13. Who may decide a waiting item. The reviewer roles come from the Keycloak token as
# contextual tuples, like the doctor facts above. Each item's company is stored when it is made.
type draft
  relations
    define company: [company]
    define can_decide: medical_reviewer from company

type adverse_event
  relations
    define company: [company]
    define can_decide: safety_reviewer from company

# Lesson 14. An email the fact-checker flagged waits for a medical reviewer; an outreach step
# waits for a sales rep.
type email
  relations
    define company: [company]
    define can_decide: medical_reviewer from company

type outreach
  relations
    define company: [company]
    define can_decide: sales_rep from company

# Lesson 22. A company's sales data. Only its analysts may ask the insights agent about it: a sales
# rep or a doctor of the same company may not. Postgres holds the same line again, by login.
type dataset
  relations
    define owner: [company]
    define can_query: analyst from owner
