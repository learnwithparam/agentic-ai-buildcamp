{
  "name": "langfuse-hcp-medinfo-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "medinfo": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:server && npm run build:cli",
    "build:client": "vite build",
    "build:server": "tsup src/server/index.ts --format esm --out-dir dist/server --clean",
    "build:cli": "tsup src/cli/index.tsx --format esm --out-dir dist/cli --clean",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "medinfo": "tsx src/cli/index.tsx",
    "prompt:publish": "tsx scripts/publish-prompt.ts",
    "dataset:seed": "tsx scripts/seed-dataset.ts",
    "judge:calibrate": "tsx scripts/judge-calibrate.ts",
    "citations:audit": "tsx scripts/citations-audit.ts",
    "dataset:run": "tsx scripts/run-dataset.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "langfuse:seed:error-analysis": "tsx scripts/seed-error-analysis-traces.ts",
    "langfuse:seed:error-analysis:annotations": "tsx scripts/seed-error-analysis-annotations.ts",
    "langfuse:seed:calibration": "tsx scripts/seed-faithfulness-calibration.ts",
    "check:live": "tsx --test --test-concurrency=1 'src/**/*.live.ts' 'scripts/**/*.live.ts'",
    "check": "npm run typecheck && tsx --test 'scripts/**/*.test.ts' 'src/**/*.test.ts' && tsx scripts/check-repo.ts",
    "langfuse:gateway-keys": "tsx scripts/langfuse-gateway-keys.ts",
    "langfuse:code-eval": "tsx scripts/langfuse-code-eval.ts",
    "identity:setup": "tsx scripts/identity-setup.ts",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d --wait",
    "rag:setup": "tsx scripts/rag-setup.ts",
    "rag:ingest": "tsx scripts/rag-ingest.ts",
    "identity:smoke": "tsx scripts/identity-smoke.ts",
    "events:send": "tsx scripts/events-send.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "citations:replay": "tsx scripts/citations-replay.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "@assistant-ui/react": "0.15.38",
    "@assistant-ui/react-langgraph": "0.14.42",
    "@assistant-ui/react-markdown": "0.14.26",
    "@assistant-ui/store": "0.3.25",
    "@assistant-ui/tap": "0.9.27",
    "@langchain/core": "1.5.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/langgraph-sdk": "1.17.0",
    "@langfuse/client": "6.1.1",
    "@langfuse/openai": "6.1.1",
    "@langfuse/otel": "6.1.1",
    "@langfuse/tracing": "6.1.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/keyring": "2.1.2",
    "@openfga/sdk": "0.9.8",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-node": "0.223.2",
    "amaro": "1.3.0",
    "commander": "15.1.0",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "ink": "8.0.0",
    "jose": "6.2.17",
    "kysely": "0.29.9",
    "open": "11.0.4",
    "openai": "7.63.0",
    "openid-client": "6.8.9",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "postal-mime": "4.2.1",
    "quickjs-emscripten": "0.32.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "standardwebhooks": "1.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
